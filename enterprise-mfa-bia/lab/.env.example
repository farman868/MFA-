# Copy to lab/.env, or let scripts/setup_lab.sh generate one with random values (recommended).
# LAB SECRETS ONLY - never reuse these values anywhere else.
LDAP_ADMIN_PASSWORD=change-me
LDAP_CONFIG_PASSWORD=change-me
LDAP_READONLY_PASSWORD=change-me
KC_DB_PASSWORD=change-me
KC_ADMIN_USER=kcadmin
KC_ADMIN_PASSWORD=change-me
CORP_PORTAL_CLIENT_SECRET=change-me
HR_PORTAL_CLIENT_SECRET=change-me
VPN_RADIUS_CLIENT_SECRET=change-me
BRIDGE_API_KEY=change-me
OTP_HMAC_KEY=change-me
PORTAL_SESSION_KEY=change-me
RADIUS_SHARED_SECRET=change-me
# Synthetic-monitoring account (realm-local, not in LDAP) used by verify_mfa.py and the VPN test client
SVC_PROBE_PASSWORD=change-me-14chars+
# Raw TOTP seed (Keycloak stores the raw string; authenticator apps receive base32 of these bytes)
SVC_PROBE_TOTP_SEED=change-me-20-chars
