  "authenticationFlows": [
    {
      "id": "flow-enterprise-browser",
      "alias": "enterprise-browser",
      "description": "Cookie SSO, then password + role-based MFA tier",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "enterprise-browser-forms",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "id": "flow-enterprise-browser-forms",
      "alias": "enterprise-browser-forms",
      "description": "Password, initial-enrolment OTP if needed, then exactly one MFA tier",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "initial-enrolment-otp",
          "requirement": "CONDITIONAL",
          "priority": 15,
          "userSetupAllowed": false
