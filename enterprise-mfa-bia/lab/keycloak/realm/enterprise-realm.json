  "roles": {
    "realm": [
      {
        "name": "mfa-tier-webauthn",
        "description": "AAL3 tier: phishing-resistant FIDO2/WebAuthn (platform biometrics or hardware key) required",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "mfa-tier-totp",
        "description": "AAL2 tier: TOTP authenticator app required",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "mfa-tier-otp-fallback",
        "description": "Accessibility / no-smartphone fallback: SMS or Email OTP via mfa-otp-bridge",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "it-admins",
        "description": "Privileged IT and IAM administrators",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "vpn-users",
        "description": "Authorized for OpenVPN remote access (RADIUS + TOTP)",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "browserFlow": "enterprise-browser",
  "users": [
    {
      "username": "svc.mfa-probe",
      "enabled": true,
      "emailVerified": true,
      "firstName": "MFA",
      "lastName": "Probe",
      "email": "svc.mfa-probe@corp.enterprise.local",
      "attributes": {
        "department": [
          "ServiceAccounts"
        ],
        "purpose": [
          "Synthetic monitoring of SSO, VPN and SIEM pipelines (lab automation)"
        ]
      },
      "realmRoles": [
        "default-roles-enterprise-realm",
        "mfa-tier-totp",
        "vpn-users"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${SVC_PROBE_PASSWORD}",
          "temporary": false
        },
        {
          "type": "otp",
          "userLabel": "probe-automation",
          "secretData": "{\"value\": \"${SVC_PROBE_TOTP_SEED}\"}",
          "credentialData": "{\"subType\": \"totp\", \"digits\": 6, \"counter\": 0, \"period\": 30, \"algorithm\": \"HmacSHA1\"}"
        }
      ]
    }
  ],
